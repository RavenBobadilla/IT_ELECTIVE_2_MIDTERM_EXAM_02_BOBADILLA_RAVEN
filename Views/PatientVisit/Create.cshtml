@model PatientVisit

@{
    ViewData["Title"] = "Register Patient Visit";
}

<h2>Register Patient Visit</h2>

@Html.ValidationSummary(true, "", new { @class = "text-danger" })

<form asp-action="Create" method="post" class="mt-3">
    <div class="form-group">
        <label asp-for="FirstName"></label>
        <input asp-for="FirstName" class="form-control" placeholder="Enter first name" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="LastName"></label>
        <input asp-for="LastName" class="form-control" placeholder="Enter last name" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Age"></label>
        <input asp-for="Age" class="form-control" placeholder="Enter age" />
        <span asp-validation-for="Age" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Sex"></label>
        <select asp-for="Sex" class="form-control">
            <option value="">Select sex</option>
            <option>Male</option>
            <option>Female</option>
        </select>
        <span asp-validation-for="Sex" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ContactNumber"></label>
        <input asp-for="ContactNumber" class="form-control" placeholder="Enter contact number" />
        <span asp-validation-for="ContactNumber" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Address"></label>
        <input asp-for="Address" class="form-control" placeholder="Enter address" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Physician"></label>
        <input asp-for="Physician" class="form-control" placeholder="Enter physician name" />
        <span asp-validation-for="Physician" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="VisitType"></label>
        <input asp-for="VisitType" class="form-control" placeholder="Enter visit type (e.g., Check-up)" />
        <span asp-validation-for="VisitType" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ArrivalDateTime"></label>
        <input asp-for="ArrivalDateTime" class="form-control" type="datetime-local" />
        <span asp-validation-for="ArrivalDateTime" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ChiefComplaint"></label>
        <textarea asp-for="ChiefComplaint" class="form-control" placeholder="Enter chief complaint"></textarea>
        <span asp-validation-for="ChiefComplaint" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Notes"></label>
        <textarea asp-for="Notes" class="form-control" placeholder="Additional notes"></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Save Visit</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>
