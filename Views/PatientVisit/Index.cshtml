@model IEnumerable<PatientVisit>

@{
    ViewData["Title"] = "Patient Visit Monitoring";
}

<h2>Patient Visit Monitoring</h2>

<form asp-action="Search" method="get" class="form-inline mb-3">
    <input type="text" name="keyword" class="form-control mr-2" placeholder="Search by name..." />
    <button type="submit" class="btn btn-primary">Search</button>
</form>

<table class="table table-striped table-bordered">
    <thead class="thead-dark">
        <tr>
            <th>Visit Number</th>
            <th>Patient</th>
            <th>Physician</th>
            <th>Visit Type</th>
            <th>Arrival Time</th>
            <th>Consultation End</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var visit in Model)
            {
                <tr>
                    <td>@visit.VisitNumber</td>
                    <td>@visit.FirstName @visit.LastName</td>
                    <td>@visit.Physician</td>
                    <td>@visit.VisitType</td>
                    <td>@visit.ArrivalDateTime.ToString("g")</td>
                    <td>@visit.ConsultationCompletedDateTime?.ToString("g")</td>
                    <td>
                        <span class="badge
                            @(visit.Status == "Waiting" ? "badge-warning" :
                                visit.Status == "In Consultation" ? "badge-info" :
                                "badge-success")">
                            @visit.Status
                        </span>
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@visit.Id" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="Edit" asp-route-id="@visit.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Complete" asp-route-id="@visit.Id" class="btn btn-sm btn-success">Complete</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8" class="text-center text-muted">No patient visits found.</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-primary">+ Register New Visit</a>
