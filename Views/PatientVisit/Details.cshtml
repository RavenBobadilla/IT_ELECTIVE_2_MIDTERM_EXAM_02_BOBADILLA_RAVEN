@model PatientVisit

@{
    ViewData["Title"] = "Patient Visit Details";
}

<h2>Patient Visit Details</h2>

<div class="card mt-3">
    <div class="card-header">
        Visit Number: @Model.VisitNumber
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Patient Name</dt>
            <dd class="col-sm-9">@Model.FirstName @Model.LastName</dd>

            <dt class="col-sm-3">Age</dt>
            <dd class="col-sm-9">@Model.Age</dd>

            <dt class="col-sm-3">Sex</dt>
            <dd class="col-sm-9">@Model.Sex</dd>

            <dt class="col-sm-3">Contact Number</dt>
            <dd class="col-sm-9">@Model.ContactNumber</dd>

            <dt class="col-sm-3">Address</dt>
            <dd class="col-sm-9">@Model.Address</dd>

            <dt class="col-sm-3">Physician</dt>
            <dd class="col-sm-9">@Model.Physician</dd>

            <dt class="col-sm-3">Visit Type</dt>
            <dd class="col-sm-9">@Model.VisitType</dd>

            <dt class="col-sm-3">Arrival Date & Time</dt>
            <dd class="col-sm-9">@Model.ArrivalDateTime.ToString("g")</dd>

            <dt class="col-sm-3">Consultation End</dt>
            <dd class="col-sm-9">@Model.ConsultationCompletedDateTime?.ToString("g")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                <span class="badge 
                    @(Model.Status == "Waiting" ? "badge-warning" :
                      Model.Status == "In Consultation" ? "badge-info" :
                      "badge-success")">
                    @Model.Status
                </span>
            </dd>

            <dt class="col-sm-3">Chief Complaint</dt>
            <dd class="col-sm-9">@Model.ChiefComplaint</dd>

            <dt class="col-sm-3">Notes</dt>
            <dd class="col-sm-9">@Model.Notes</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
